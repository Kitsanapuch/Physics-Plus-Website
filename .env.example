# Template only. Do not put real credentials in this file or commit .env.local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional exact HTTPS production origin for a custom domain.
# Vercel preview URLs are accepted from VERCEL_URL / VERCEL_BRANCH_URL.
PH_PUBLIC_ORIGIN=
# Transactional update email: choose Gmail SMTP or Resend. Never use your
# ordinary Google Account password; use a separate 16-character App Password.
# All values are server-only secrets/settings in Vercel, never browser variables.
PH_GMAIL_USER=
PH_GMAIL_APP_PASSWORD=
# Optional alternative. If both providers are complete, Gmail takes priority.
# Resend requires a verified sender domain.
RESEND_API_KEY=
PH_EMAIL_FROM=
PH_ADMIN_NOTIFICATION_EMAIL=
# A long random value used only by Vercel Cron to retry queued mail/sheet sync.
CRON_SECRET=
# Private Google Sheets mirror. Share only the target sheet with the service
# account client_email as Editor. The JSON key belongs in a Vercel secret, not Git.
PH_GOOGLE_SHEET_ID=
PH_GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional emergency fallback: 0 disables Vercel Queue delivery and makes
# successful writes wait for sheet/email dispatch in the request again.
PH_DELIVERY_QUEUE_ENABLED=
